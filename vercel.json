{
  "version": 2,
  "functions": {
    "api/itinerary.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/itinerary",
      "destination": "/api/itinerary.js"
    },
    {
      "source": "/api/login",
      "destination": "/api/login.js"
    },
    {
      "source": "/api/logout",
      "destination": "/api/logout.js"
    },
    {
      "source": "/api/session",
      "destination": "/api/session.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
